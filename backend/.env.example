PORT=4000
APP_NAME=Kappio Backend
NODE_ENV=development

# Access token (15m default)
JWT_SECRET=replace-me
JWT_EXPIRES_IN=15m

# Refresh token (RS256 optional; use strong random in production)
JWT_REFRESH_SECRET=replace-with-a-different-long-secret
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL=postgres://postgres:postgres@localhost:5432/kappio

# CORS: comma-separated origins; required for browser cookies with credentials
CORS_ORIGIN=http://localhost:5173

# Invite email links (admin → team invite)
FRONTEND_ORIGIN=http://localhost:5173
# INVITE_PATH=/invite/setup-password

# Cookie hardening in production
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_PATH=/
